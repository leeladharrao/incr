{
    "name": "incr",
    "type": "docker",
    "build": {
        "buildCommand": "pnpm install && pnpm build"
    },
    "run": {
        "command": "node dist/index.js"
    },
    "ports": [
        {
            "port": 8000,
            "protocol": "http"
        }
    ],
    "env": [
        {
            "key": "PORT",
            "value": "8000"
        },
        {
            "key": "HOST",
            "value": "0.0.0.0"
        },
        {
            "key": "NODE_ENV",
            "value": "production"
        }
    ],
    "regions": [
        "was"
    ],
    "scaling": {
        "min": 1,
        "max": 3
    }
}